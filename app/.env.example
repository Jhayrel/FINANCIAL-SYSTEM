# Firebase — copy to .env.local and fill from
# Firebase console -> Project settings -> Your apps -> SDK setup and configuration.
#
# All six of these are PUBLIC. The web apiKey is a project identifier, not a
# secret; the security rules and the signed-in uid are what protect the data.
# Leave them all blank and the app runs on browser storage instead.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Your uid, from Firebase console -> Authentication -> Users.
# Must match ownerUid() in firestore.rules.
VITE_OWNER_UID=

# NOT HERE. The AI provider key is a real secret and must never reach the
# browser. It goes in Cloudflare -> Pages -> Settings -> Environment variables
# as AI_API_KEY, read only by a server function. See CLAUDE.md section 2.
