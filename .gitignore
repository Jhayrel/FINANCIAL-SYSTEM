# ── Dependencies ───────────────────────────────────────────────
node_modules/

# ── Build output ───────────────────────────────────────────────
dist/
.vite/
*.tsbuildinfo

# ── Private data — NEVER commit ────────────────────────────────
# "MY THINGS" holds the original workbook, which contains BOTH live API keys
# (CATEGORIES!U7:U16) and a full personal financial history. It must never
# reach GitHub. The folder stays on disk and in OneDrive — this only keeps it
# out of git. Do not remove these lines.
MY THINGS/
*.xlsm
*.xlsx

# Extracted fixtures contain real transaction data too.
app/src/fixtures/*.json
tools/out/

# Coderview dumps are the entire database in one text file: every transaction,
# every message to the assistant, every correction. The screen that makes them
# suggests saving into MY THINGS/CODERVIEW/, which is already excluded above,
# but a dump saved anywhere else in the tree must not be committable either.
# Extensions only, never a bare prefix: git ignores case-insensitively on
# Windows, so `coderview*` would also swallow the screen's own source file
# and its test, and they would go missing from the repository silently.
coderview*.txt
coderview*.json
coderview*.md
CODERVIEW/

# ── Secrets — never commit ─────────────────────────────────────
# API keys live in Cloudflare environment secrets, never in the tree.
.env
.env.*
!.env.example
*.key
serviceAccount*.json
firebase-adminsdk*.json

# ── Local tooling ──────────────────────────────────────────────
.firebase/
.wrangler/
coverage/

# ── OS / editor ────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# ── OneDrive / Excel debris ────────────────────────────────────
~$*
*.tmp
