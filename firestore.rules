rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
//  Firestore security rules: Financial Management System
//
//  This database holds one person's entire financial history. The rules are a
//  deny-by-default whitelist: nothing is readable or writable unless a rule
//  below explicitly allows it.
//
//  Four things enforced here, because the client cannot be trusted to:
//
//   1. ONE OWNER.       Signed in is not enough. The uid must equal OWNER_UID.
//   2. NO HARD DELETE.  `delete` is denied on every money collection. Removing
//                       a transaction means setting `deletedAt`, which moves it
//                       to the Bin and keeps it restorable (CLAUDE.md §4).
//   3. INTEGER MONEY.   A float amount is rejected at the database. Centavos
//                       end to end, never a rounding error at rest.
//   4. NO SECRETS.      A document carrying an apiKey-shaped field is rejected.
//                       The AI key lives in a Cloudflare env secret (§2, AI4).
//   5. AUDIT IS FINAL.  The activity log takes creates and refuses updates and
//                       deletes, so the record of what happened cannot be
//                       edited after the fact, by anything, including this app.
//
//  ── What these rules can and cannot say about the assistant ───────────────
//
//  They cannot grant or deny the AI anything, and no rule below pretends to.
//  The assistant is a text endpoint: it reads a prompt and returns JSON. It
//  holds no Firestore handle, has no Firebase identity, and never connects to
//  this database. Every write still comes from the browser, signed in as the
//  owner, so `request.auth.uid` is the owner's uid whether a row was typed or
//  read off a receipt. There is no second principal for a rule to match on.
//
//  What the rules can do, and now do:
//
//   - Record which it was. `entrySource` is written on every transaction and
//     validated here, so provenance is in the data rather than in a memory.
//   - Keep that record honest. The activity log is append only at the
//     database, so an event cannot be revised into saying something else.
//   - Keep settings out of it. There is no code path from the assistant to
//     the settings document: `AskPanel` is handed three functions, all of
//     which go through `checkDraft` and the transactions collection. Settings
//     stay owner-and-form-only because nothing else can reach them, which is
//     a stronger guarantee than a rule that cannot tell who is asking.
//
//  The gate that actually protects the ledger is not here. It is the Add
//  button: a proposal is a filled-in form that has not been submitted, and
//  `checkDraft` runs on it exactly as it runs on a typed one.
//
//  Deploy:  firebase deploy --only firestore:rules
//  Test:    firebase emulators:start --only firestore
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Who ────────────────────────────────────────────────────────────────

    // The owner's uid, from Firebase console → Authentication → Users.
    // Until it is replaced, every rule below denies. An unset owner must fail
    // closed; a placeholder that happened to allow access would be worse than
    // no rules at all.
    function ownerUid() {
      return 'RJD4Ads5gKMcbmVqaU3JnhvDe6G2';
    }

    function isOwner(uid) {
      return request.auth != null
          && request.auth.uid == uid
          && request.auth.uid == ownerUid();
    }

    // ── Shape helpers ──────────────────────────────────────────────────────

    function incoming() {
      return request.resource.data;
    }

    // Money is integer centavos. A float means someone did arithmetic in
    // pesos: the exact bug class this app is built to avoid. ±₱1,000,000,000
    // is far past any real figure here and still well inside a safe integer.
    function isCentavos(v) {
      return v is int && v > -100000000000 && v < 100000000000;
    }

    // Key names that have no business in this database. The UI refuses to save
    // a key; this is the layer that holds when the UI is bypassed.
    function noSecretKeys(keys) {
      return !keys.hasAny(['apiKey', 'api_key', 'apikey', 'key', 'token',
                           'secret', 'authorization', 'bearer']);
    }

    // ── Transactions ───────────────────────────────────────────────────────
    //
    // The ledger. One document per row. A binned row stays right here with
    // `deletedAt` set: there is no second collection to drift out of sync,
    // and no code path that removes a money record.

    function validTransaction() {
      let d = incoming();
      return d.keys().hasAll([
               'recordNumber', 'date', 'type', 'fromWallet', 'toWallet',
               'category', 'item', 'description', 'amount', 'fee', 'total',
               'notes', 'status'
             ])
          && d.recordNumber is int && d.recordNumber > 0
          && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.type in ['Revenue', 'Spending', 'Transfer', 'Debt']
          && d.category in ['Revenue', 'Spending', 'Bills', 'Subscriptions',
                            'Transfer', 'Opening', '']
          && d.fromWallet is string && d.fromWallet.size() <= 80
          && d.toWallet is string && d.toWallet.size() <= 80
          && d.item is string && d.item.size() <= 80
          && d.description is string && d.description.size() <= 500
          && d.notes is string && d.notes.size() <= 1000
          && d.status is string && d.status.size() <= 40
          && isCentavos(d.amount)
          && isCentavos(d.fee)
          && isCentavos(d.total)
          // The invariant the whole ledger rests on. Enforced here so no
          // client can write a row whose parts do not add up.
          && d.total == d.amount + d.fee
          // A Debt row without its debt cannot be reconciled later (rule D1).
          && (d.type != 'Debt' || (
                d.debtId is string && d.debtId.size() > 0
             && d.debtEffect in ['draw', 'repay', 'interest', 'fee',
                                 'writeoff', 'lend', 'collect']
             ))
          // Present means binned; absent means live. Nothing else.
          && (!('deletedAt' in d) || d.deletedAt is string)
          // Who filled this row in. Optional, because every row written before
          // the assistant existed has no opinion on the matter, and rejecting
          // those would make the whole history unwritable.
          && (!('entrySource' in d) || d.entrySource in ['manual', 'ai'])
          && noSecretKeys(d.keys());
    }

    match /users/{uid}/transactions/{txId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validTransaction();

      // Never. Deleting is `deletedAt`, and restoring clears it. There is no
      // gesture anywhere in the app that should reach this line.
      allow delete: if false;
    }

    // ── Settings ───────────────────────────────────────────────────────────
    //
    // Accounts, goals, categories, spending types, credit lines, AI
    // preferences, theme. One document, rewritten whole on every edit.

    function validSettings() {
      let d = incoming();
      return d.version is int
          && d.accounts is list && d.accounts.size() <= 200
          && d.bills is list && d.bills.size() <= 100
          && d.subscriptions is list && d.subscriptions.size() <= 100
          && d.revenueCategories is list && d.revenueCategories.size() <= 100
          && d.spendingTypes is list && d.spendingTypes.size() <= 100
          && d.credits is list && d.credits.size() <= 100
          && isCentavos(d.lowBalanceThreshold)
          && d.theme in ['light', 'dark', 'system']
          && d.ai is map
          && d.ai.enabled is bool
          && d.ai.provider in ['groq', 'openrouter', 'openai', 'anthropic']
          && d.ai.model is string && d.ai.model.size() <= 80
          && d.ai.tone in ['brief', 'plain', 'detailed']
          // There is no API key field in the app, and none may be introduced
          // by writing one straight into the console. Rule AI4.
          && noSecretKeys(d.keys())
          && noSecretKeys(d.ai.keys());
    }

    //
    // Nothing the assistant produces reaches this document. It proposes
    // transactions and only transactions, through `checkDraft` and the Add
    // button, so accounts, credit lines, categories and AI preferences are
    // reachable only from the Settings screen. That is a property of the code
    // rather than of this rule: a rule cannot tell the two apart, because both
    // arrive as the same signed-in owner.

    match /users/{uid}/meta/settings {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validSettings();
      allow delete: if false;
    }

    // ── Activity ───────────────────────────────────────────────────────────
    //
    // What happened, when, and who did it. One document per event, and the
    // only collection in this database that is append only at the database
    // rather than by convention: `update` and `delete` are both denied, so an
    // event cannot be revised after the fact by this app, by the console, or
    // by anything holding the owner's credentials.
    //
    // `actor` is the field that answers "did the AI do this". It is written by
    // the client, and a client can write either value, so it is a record and
    // not a control. The control is that the assistant has no writer at all.

    function validActivity() {
      let d = incoming();
      return d.keys().hasAll(['at', 'actor', 'via', 'action', 'summary'])
          && d.at is string && d.at.size() <= 40
          && d.actor in ['owner', 'ai']
          && d.via in ['manual', 'ai_chat', 'ai_image', 'csv_import',
                       'migration', 'restore', 'system']
          && d.action is string && d.action.size() <= 60
          && d.summary is string && d.summary.size() <= 300
          && (!('targetId' in d) || (d.targetId is string && d.targetId.size() <= 80))
          && (!('recordNumber' in d) || d.recordNumber is int)
          && (!('model' in d) || (d.model is string && d.model.size() <= 120))
          && (!('amount' in d) || isCentavos(d.amount))
          && (!('before' in d) || (d.before is string && d.before.size() <= 600))
          && (!('after' in d) || (d.after is string && d.after.size() <= 600))
          && noSecretKeys(d.keys());
    }

    match /users/{uid}/activity/{eventId} {
      allow read:   if isOwner(uid);
      allow create: if isOwner(uid) && validActivity();

      // Append only. An audit trail that can be edited is not one.
      allow update, delete: if false;
    }

    // ── Budgets ────────────────────────────────────────────────────────────
    //
    // One document per year, id "2026". Twelve amounts per track, index 0 =
    // January, matching the Excel's BUDGETING sheet.

    match /users/{uid}/budgets/{year} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
                            && year.matches('^[0-9]{4}$')
                            && incoming().spending is list
                            && incoming().spending.size() == 12
                            && incoming().billsSubs is list
                            && incoming().billsSubs.size() == 12;
      allow delete: if false;
    }

    // ── No debts collection ────────────────────────────────────────────────
    //
    // Credit lines and loans live inside the settings document, as
    // `settings.credits`, because they are a short list the app always reads
    // whole. There is no `users/{uid}/debts` collection, so there is no rule
    // for one: a rule guarding a collection nothing writes reads like a
    // feature and is really just a place for a future mistake to hide.
    //
    // The movements themselves are ordinary transactions carrying `debtId`.

    // ── Everything else ────────────────────────────────────────────────────
    //
    // Explicit, so a collection added by hand in the console later is not
    // silently world-readable.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
